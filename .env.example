# Environment Variables Example
# DO NOT commit actual values - use Doppler for secret management

# Logging Configuration
LOG_LEVEL=INFO

# Sentry Configuration (Managed by Doppler)
# Get these values from: doppler secrets --project integrity-studio --config dev
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=development

# Doppler Configuration
# Run commands with: doppler run --project integrity-studio --config dev -- [command]
# Or load secrets: eval $(doppler secrets download --project integrity-studio --config dev --format env-no-quotes)

# Testing
# Set to 'true' to disable Sentry during tests
TESTING=false
