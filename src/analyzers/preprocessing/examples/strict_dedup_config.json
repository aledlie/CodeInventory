{
  "$comment": "Strict deduplication - aggressive duplicate removal with lower threshold",

  "cleaning": {
    "enabled": true,
    "normalize_paths": true,
    "normalize_names": true,
    "clean_meta_variables": true
  },

  "transformation": {
    "enabled": true,
    "detect_patterns": true,
    "calculate_complexity": true,
    "resolve_dependencies": true,
    "min_pattern_confidence": 0.8,
    "max_patterns_per_candidate": 3
  },

  "deduplication": {
    "enabled": true,
    "threshold": 0.70,
    "group_similar": true,
    "keep_representative": true
  },

  "dashboard": {
    "enabled": true,
    "build_indexes": true,
    "build_search_index": true,
    "precompute_charts": true,
    "page_size": 20
  }
}
