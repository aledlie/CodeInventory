{
  "name": "code-inventory",
  "version": "1.0.0",
  "description": "Code analysis and documentation system using ast-grep and Schema.org",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
